{
  "name": "tu-economia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "react-router typegen && tsc",
    "typecheck:scripts": "pyright",
    "lint": "eslint .",
    "format": "prettier --write app workers eslint.config.mjs react-router.config.ts vite.config.ts wrangler.jsonc",
    "format:check": "prettier --check app workers eslint.config.mjs react-router.config.ts vite.config.ts wrangler.jsonc",
    "test:unit": "vitest run",
    "test:scripts": "python3 -m unittest discover -s scripts",
    "test": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:scripts && pnpm run test:unit && pnpm run test:scripts && pnpm run build"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "fast-xml-parser": "^5.11.1",
    "html-entities": "2.6.0",
    "isbot": "^5.1.36",
    "lenis": "^1.3.23",
    "motion": "^12.40.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.6.0",
    "react-router": "8.4.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.147.0"
  }
}
